### Create a new quiz
POST http://localhost:8080/api/quizzes
Content-Type: application/json
User-Id: 1

{
  "title": "Mathematics Quiz - Algebra",
  "description": "Test your knowledge of algebraic equations and simultaneous equations.",
  "timeLimit": 30,
  "questions": [
    {
      "type": "MULTIPLE_CHOICE",
      "text": "What is the solution to the equation 2x + 5 = 13?",
      "options": [
        {
          "text": "x = 4",
          "isCorrect": true
        },
        {
          "text": "x = 5",
          "isCorrect": false
        },
        {
          "text": "x = 6",
          "isCorrect": false
        },
        {
          "text": "x = 7",
          "isCorrect": false
        }
      ]
    },
    {
      "type": "MULTIPLE_CHOICE",
      "text": "Solve the simultaneous equations: x + y = 10 and x - y = 2",
      "options": [
        {
          "text": "x = 6, y = 4",
          "isCorrect": true
        },
        {
          "text": "x = 5, y = 5",
          "isCorrect": false
        },
        {
          "text": "x = 7, y = 3",
          "isCorrect": false
        },
        {
          "text": "x = 8, y = 2",
          "isCorrect": false
        }
      ]
    },
    {
      "type": "TRUE_FALSE",
      "text": "The quadratic formula can be used to solve any quadratic equation.",
      "options": [
        {
          "text": "True",
          "isCorrect": true
        },
        {
          "text": "False",
          "isCorrect": false
        }
      ]
    }
  ]
}

